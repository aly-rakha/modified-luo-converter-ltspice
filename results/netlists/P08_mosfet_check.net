* P08_mosfet_check.asc
* Generated by LTspice 26.0.2 for MacOS.
Vin N004 0 50
D1 N004 N001 DBASE
D2 N001 N005 DBASE
L1 N004 N008 2m Rser=100m
L2 N005 N002 2m Rser=100m
D3 N002 N006 DBASE
D4 N006 N003 DBASE
D5 N003 N007 DBASE
C1 N001 N008 50u Rser=50m
C2 N005 0 50u Rser=50m
C3 N001 N002 50u Rser=50m
C4 N006 0 50u Rser=50m
C5 N003 N002 50u Rser=50m
Co N007 0 50u Rser=50m
R1 N007 0 909.09
V1 N009 0 PULSE(0 10 0 10n 10n 4.99u 10u)
M1 N008 N010 0 0 IPP600N25N3
Rgate N010 N009 10
.model D D
.lib standard.dio
.model NMOS NMOS
.model PMOS PMOS
.lib standard.mos
.model SWBASE SW(Ron=50m Roff=1G Vt=5 Vh=0)
.model DBASE D(Ron=20m Roff=1G Vfwd=0.8)
.tran 0 400m 0 50n startup
.meas tran Vout_avg AVG V(n007) FROM 390m TO 400m
.meas tran IL1_avg AVG I(L1) FROM 390m TO 400m
.meas tran IL2_avg AVG I(L2) FROM 390m TO 400m
.meas tran IL1_min MIN I(L1) FROM 390m TO 400m
.meas tran IL2_min MIN I(L2) FROM 390m TO 400m
* ALY HANY RAKHA
.meas tran IL1_ripple PP I(L1) FROM 399.9m TO 400m
.meas tran IL2_ripple PP I(L2) FROM 399.9m TO 400m
.meas tran Vout_ripple PP V(n007) FROM 399.9m TO 400m
.meas tran Vout_ripple_pct PARAM 100*Vout_ripple/Vout_avg
.meas tran VC1_avg AVG V(n001,n008) FROM 390m TO 400m
.meas tran VC2_avg AVG V(n005) FROM 390m TO 400m
.meas tran VC3_avg AVG V(n002,n001) FROM 390m TO 400m
.meas tran VC4_avg AVG V(n006) FROM 390m TO 400m
.meas tran VC5_avg AVG V(n003,n002) FROM 390m TO 400m
.meas tran Vswitch_max MAX V(n008) FROM 390m TO 400m
.meas tran Vswitch_startup_max MAX V(n008) FROM 0 TO 100m
.meas tran Pin AVG (-V(n004)*I(Vin)) FROM 390m TO 400m
.meas tran Pout AVG (V(n007)*V(n007)/909.09) FROM 390m TO 400m
.meas tran Ploss PARAM Pin-Pout
.meas tran Efficiency_pct PARAM 100*Pout/Pin
.meas tran Pgate AVG (-V(n009)*I(V1)) FROM 390m TO 400m
.meas tran Pin_total PARAM Pin+Pgate
.meas tran Ploss_total PARAM Pin_total-Pout
.meas tran Efficiency_total_pct PARAM 100*Pout/Pin_total
.options plotwinsize=0
.backanno
.end
